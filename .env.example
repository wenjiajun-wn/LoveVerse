# 公开部署保持 demo。私人部署必须使用独立进程、独立域名和持久化磁盘。
LOVEVERSE_MODE=demo
LOVEVERSE_ORIGIN=http://localhost:3000
# 默认 <项目>/private，可改为外部私有数据目录，不可放 public/src/.next 下。
# LOVEVERSE_DATA_DIR=D:/LoveVerseData

# V3 默认禁用。仅私人环境、双方逐条明确同意后可调用云端 AI。
LOVEVERSE_AI_ENABLED=false
# 可选公开 AI 演示，仅可读取 demo.ts 的公开故事，无权访问私人回忆。
LOVEVERSE_AI_PUBLIC_DEMO=false
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 仅放在服务器 .env.local，绝不使用 NEXT_PUBLIC_ 前缀。
DEEPSEEK_API_KEY=
