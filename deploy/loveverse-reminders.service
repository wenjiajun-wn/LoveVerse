[Unit]
Description=LoveVerse 站内纪念日提醒
After=network-online.target loveverse.service

[Service]
Type=oneshot
User=loveverse
WorkingDirectory=/opt/loveverse
EnvironmentFile=/etc/loveverse/scheduler.env
ExecStart=/usr/bin/node /opt/loveverse/scripts/run-reminders.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
